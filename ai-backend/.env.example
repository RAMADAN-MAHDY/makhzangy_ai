# === Server ===
PORT=5100
NODE_ENV=development

# === Database (Conversation / Message / Summary storage only) ===
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/makhzangy_ai

# === Gemini ===
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# === Main Backend (the existing warehouse system API) ===
MAIN_BACKEND_BASE_URL=http://localhost:5000/api

# === Security ===
# Must match the Main Backend's JWT secret ONLY if this service verifies tokens itself.
# Per architecture: AI Backend forwards the client's JWT as-is to Main Backend APIs
# and does NOT re-implement authorization logic.
JWT_SECRET=same_as_main_backend_secret

# === CORS ===
FRONTEND_ORIGIN=http://localhost:3000

# === Logging ===
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Voice — STT (Speech-to-Text)
# ─────────────────────────────────────────────────────────────────────────────
STT_ENABLED=true
# Dedicated API key for STT (if omitted, falls back to GEMINI_API_KEY)
STT_API_KEY=our_gcp_api_key_here
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash
# Optional: override the built-in transcription prompt
# STT_PROMPT=

# Provider-level rate limits (system-wide across all users)
STT_RPM_LIMIT=5
STT_RPD_LIMIT=20

# Per-user default limits (used when no UserVoiceLimit doc exists for the user)
DEFAULT_USER_STT_RPM_LIMIT=3
DEFAULT_USER_STT_RPD_LIMIT=10

# ─────────────────────────────────────────────────────────────────────────────
# Voice — TTS (Text-to-Speech)
# ─────────────────────────────────────────────────────────────────────────────
TTS_ENABLED=true
# Dedicated API key for TTS (if omitted, falls back to GEMINI_API_KEY)
TTS_API_KEY=our_gcp_api_key_here
TTS_PROVIDER=gemini
TTS_MODEL=gemini-2.5-flash-preview-tts
# Voice name — see Gemini docs for available voices (e.g. Aoede, Charon, Fenrir)
TTS_VOICE=Aoede

# Provider-level rate limits
TTS_RPM_LIMIT=3
TTS_RPD_LIMIT=10

# Per-user default limits
DEFAULT_USER_TTS_RPM_LIMIT=2
DEFAULT_USER_TTS_RPD_LIMIT=5

# ─────────────────────────────────────────────────────────────────────────────
# Voice — File Constraints
# ─────────────────────────────────────────────────────────────────────────────
VOICE_MAX_FILE_SIZE_MB=10
VOICE_MAX_DURATION_SECONDS=60

